{
  "contractRevision": "space-typing-admin-ranked-v1",
  "schemaVersion": 1,
  "gameId": "space-typing",
  "capability": "ranked.read",
  "route": {
    "id": "ranked",
    "path": "/admin/space-typing/ranked",
    "label": "Ranked"
  },
  "ranked": {
    "mode": "runtime-derived-readonly",
    "runtimeSources": [
      "src/duel/ranked.ts",
      "src/duel/ranked-history.ts",
      "src/duel/ranked-history-admin.ts",
      "server/duel/ranked-service.ts",
      "server/duel/ranked-history-query-service.ts",
      "server/duel/ranked-history-store.ts"
    ],
    "liveSummary": {
      "available": true,
      "writeCapability": false
    },
    "history": {
      "available": true,
      "mode": "persisted-authoritative-readonly",
      "adminSurfaceOwner": "buildDuelRankedHistoryAdminSurface",
      "queryServiceOwner": "DuelRankedHistoryQueryService",
      "defaultScope": "self",
      "crossPlayerScope": "authorized-cross-player",
      "authenticationRequired": true,
      "crossPlayerAuthorizationRequired": true,
      "crossPlayerFailClosedWhenUnconfigured": true,
      "eventFilters": ["result", "limit"],
      "writeCapability": false
    },
    "adminWriteCapability": false,
    "publishCapability": false,
    "applyBoundary": "none",
    "unsupportedAdminOperations": [
      "change Ranked rating or settlements from Admin",
      "query another player without explicit server authorization",
      "bypass authenticated identity",
      "rewrite persisted Ranked history",
      "enable Alternative Modes in Ranked when canonical admission rejects them"
    ]
  }
}
