{
  "schemaVersion": 1,
  "configNamespace": "economy.shop",
  "runtime": {
    "endpoint": "/api/runtime/space-typing/shop",
    "applyBoundary": "new-session+new-shop-instance",
    "fallback": "bundled-policy"
  },
  "previewProtocol": {
    "version": 1,
    "available": true,
    "plannedCommand": "pnpm shop:admin-preview",
    "mutation": false
  },
  "ids": {
    "shopTypes": ["normal", "station", "traveling", "black-market", "hidden", "event", "service"],
    "itemIds": ["repair-kit", "shield-cell", "energy-cell", "nova-bomb", "emp-charge", "time-crystal", "word-bomb", "supply-beacon", "lucky-dice", "salvage-anchor", "stage-revival-core", "phoenix-core"],
    "equipmentIds": ["pulse-laser-mk1", "precision-laser-mk1", "ion-cannon-mk1", "plated-armor-mk1", "adaptive-armor-mk1", "kinetic-shell-mk1", "deflector-shield-mk1", "prism-shield-mk1", "capacitor-shield-mk1", "compact-reactor-mk1", "overclock-reactor-mk1", "fusion-reactor-mk1", "targeting-module-mk1", "salvage-module-mk1", "fortune-module-mk1", "support-drone-mk1", "assault-drone-mk1", "ward-drone-mk1", "overdrive-core-mk1", "salvage-core-mk1", "balanced-core-mk1", "arc-projector-mk2", "rail-driver-mk2", "plasma-lance-mk3", "ablative-plating-mk2", "reactive-armor-mk2", "nanoweave-hull-mk3", "discharge-shield-mk2", "harmonic-shield-mk2", "phase-shield-mk3", "efficient-reactor-mk2", "siphon-reactor-mk2", "cryo-reactor-mk3", "hunter-killer-pod-mk2", "threat-scanner-mk2", "overcharge-module-mk3", "escort-drone-mk2", "interceptor-drone-mk2", "wing-drones-mk3", "ignition-core-mk2", "momentum-core-mk2", "quantum-core-mk3"],
    "gradeIds": ["aluminum", "copper", "silver", "gold", "diamond"],
    "equipmentTiers": [1, 2, 3],
    "discoveryIds": ["black-market-signal", "echo-rift"]
  },
  "currencies": ["credits", "alloy", "starCrystal", "quantumCore"],
  "authorableSections": ["generation", "pricing", "availability", "offers", "services"],
  "deferredCapabilities": ["schedule-window", "account-targeting", "cohort-targeting", "daily-purchase-limit", "weekly-purchase-limit", "bundle-transaction", "remote-player-availability", "analytics-featured-ranking"],
  "constraints": {
    "configRevisionMax": 120,
    "badgeMax": 28,
    "currencyAmount": { "min": 0, "max": 10000000, "integer": true },
    "stock": { "min": 0, "max": 99, "integer": true },
    "generatedCount": { "min": 0, "max": 50, "integer": true },
    "stage": { "min": 1, "max": 1000, "integer": true },
    "probability": { "min": 0, "max": 1 },
    "luck": { "min": 0, "max": 100 },
    "progression": { "min": 0, "max": 1000000, "integer": true },
    "gradeWeight": { "min": 0, "max": 1000000 }
  },
  "ownership": {
    "itemIdentity": "items.registry",
    "equipmentIdentity": "equipment.registry",
    "generatedInstances": "PlayerSave.shopState",
    "shopPolicy": "economy.shop",
    "progressionCosts": "progression/upgrades"
  }
}
