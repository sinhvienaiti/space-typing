      "password",
      "matchLengthSeconds",
      "roundFormat",
      "mapSelection",
      "hazardLevel",
      "mysteryFrequency",
      "fateFrequency",
      "botAllowed",
      "seedMode",
      "fixedSeed",
      "modifier"
