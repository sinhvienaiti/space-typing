      "roomNameLength": {"min": 2, "max": 40},
      "privatePasswordLength": {"min": 4, "max": 64},
      "fixedSeed": {"min": 0, "max": 4294967295, "integer": true}
    },
    "safeDefaults": {
      "visibility": "private",
      "matchLengthSeconds": 240,
      "roundFormat": 3,
      "mapSelection": {"mode": "fixed", "mapId": "frost-wastes"},
      "hazardLevel": "standard",
      "mysteryFrequency": "standard",
      "fateFrequency": "standard",
      "botAllowed": true,
      "seedMode": "random",
      "modifier": "standard"
    },
    "bot": {
      "wpm": {"min": 10, "max": 300, "practiceDefault": 55},
      "accuracy": {"min": 0.5, "max": 1, "practiceDefault": 0.94},
