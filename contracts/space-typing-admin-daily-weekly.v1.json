{
  "contractRevision": "space-typing-admin-daily-weekly-v1",
  "schemaVersion": 1,
  "gameId": "space-typing",
  "capability": "daily-weekly.read",
  "route": {
    "id": "daily-weekly",
    "path": "/admin/space-typing/daily-weekly",
    "label": "Daily / Weekly"
  },
  "liveOps": {
    "mode": "runtime-readonly",
    "runtimeSources": [
      "src/expansion-v2/challenge.ts",
      "src/expansion-v2/profile-store.ts",
      "src/expansion-v2/weekly-challenge-runtime.ts",
      "src/expansion-v2/weekly-challenge-admin.ts",
      "src/expedition/session.ts"
    ],
    "daily": {
      "available": true,
      "identity": "canonical-utc-day-expedition-challenge",
      "resetBoundary": "UTC-day",
      "seedOwner": "dailySeed(dayKey, rulesetVersion)",
      "adminMode": "read-only",
      "writeCapability": false
    },
    "weekly": {
      "available": true,
      "identity": "canonical-utc-iso-week-expedition-challenge",
      "weekKeyOwner": "weeklyChallengeWeekKey(date)",
      "seedOwner": "weeklySeed(weekKey, rulesetVersion)",
      "runtimeOwner": "weekly-challenge-runtime + weekly-challenge-admin",
      "adminMode": "read-only",
      "readableState": [
        "weekKey",
        "seed",
        "identityKey",
        "resumeStatus",
        "rewardClaimed",
        "personalBest",
        "ghostPointCount",
        "leaderboardEligible"
      ],
      "writeCapability": false,
      "schedulerControlCapability": false,
      "rewardAuthoringCapability": false,
      "seedOverrideCapability": false
    },
    "adminWriteCapability": false,
    "scheduleAuthoringCapability": false,
    "rewardAuthoringCapability": false,
    "publishCapability": false,
    "applyBoundary": "none",
    "unsupportedAdminOperations": [
      "override canonical Daily or Weekly seed",
      "change UTC Daily or ISO-week reset identity",
      "author Weekly rewards",
      "schedule Weekly challenges from Admin",
      "mutate browser-local player challenge progress",
      "fabricate remote leaderboard data"
    ]
  }
}
