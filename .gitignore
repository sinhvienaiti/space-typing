node_modules/
dist/
coverage/
# Gate evidence and review outputs, the only copy (parent docs/CLAUDE_PROCESS_2026-10-24.md §8).
tmp/
.DS_Store
public/local-assets/
# Owner's original art for scripts/bg-art: not served, back it up separately.
# Only the READMEs (where the files go) and the 3D source list are tracked.
art-src/*
!art-src/README.md
!art-src/3d/
art-src/3d/*
!art-src/3d/README.md
!art-src/3d/SOURCES.json
# Stamp written by pnpm media:pull (parent repo) so ./play.sh rebuilds after a pull.
/.media-pulled
# rclone credentials (pnpm media:setup) never belong in a repo.
rclone.conf
*.rclone.conf
# Screenshots from pnpm visual:shot (docs/VISUAL_TESTING.md).
.visual/
.duel-local/
# Typing Defense media: models, images and sounds never go in Git; only the
# README (where the files go) and the manifests are tracked (docs/td/BUILD_NOW.md §2).
public/assets/td/**
!public/assets/td/**/
!public/assets/td/README.md
!public/assets/td/**/manifest.json
# Space runtime media (GLB models, 3D ship hulls, the defense-maps images) lives
# on Google Drive and is listed in media.md5 (parent docs/MEDIA_STORAGE.md), so a
# stray `git add -A` cannot publish it (code review #74). The manifests,
# model.json and text docs (*.md, *.txt: README, CREDITS, LICENSE.txt) stay
# visible; files tracked before 24/10 stay tracked.
public/assets/space-typing/models/**
!public/assets/space-typing/models/**/
!public/assets/space-typing/models/**/*.json
!public/assets/space-typing/models/**/*.md
!public/assets/space-typing/models/**/*.txt
public/assets/space-typing/ships/3d/**
!public/assets/space-typing/ships/3d/**/
!public/assets/space-typing/ships/3d/**/*.json
!public/assets/space-typing/ships/3d/**/*.md
!public/assets/space-typing/ships/3d/**/*.txt
docs/art-requests/defense-maps/*
!docs/art-requests/defense-maps/*.md
!docs/art-requests/defense-maps/*.txt
# Local account database (PGlite) and server log: pnpm account:local.
.account-local/
# Cloudflare local secrets and state (pnpm account:local).
cloud/.dev.vars
cloud/.wrangler/
.wrangler/

# Local archives and review outputs (not for git)
/art.zip
/art-src1310.zip
/output/
