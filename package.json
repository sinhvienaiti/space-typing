{
  "name": "space-typing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3004",
    "build": "node scripts/check-audio-assets.mjs && node scripts/check-background-assets.mjs && node scripts/bg-art/check-expansion-v2.mjs && node scripts/bg-art/check-credit-puzzle-art.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && vite build && node scripts/report-bundle-metrics.mjs && node scripts/check-ship-art-integrity.mjs && node scripts/check-background-art.mjs",
    "test": "vitest run tests",
    "stamina:audit": "node --import tsx scripts/audit-warp-economy.ts",
    "check": "pnpm test && pnpm build",
    "duel:server": "tsx server/duel/ws-server.ts",
    "duel:local": "node scripts/local-duel.mjs start",
    "duel:local:stop": "node scripts/local-duel.mjs stop",
    "duel:local:restart": "node scripts/local-duel.mjs restart",
    "duel:server:check": "tsc -p tsconfig.server.json --noEmit",
    "duel:token": "tsx server/duel/token-cli.ts",
    "bg:prepare": "node scripts/bg-art/prepare-kit.mjs",
    "fx:prepare": "node scripts/bg-art/prepare-fx.mjs",
    "combat-vfx:prepare": "node scripts/bg-art/prepare-combat-vfx.mjs",
    "sprites:prepare": "node scripts/bg-art/prepare-sprites.mjs",
    "expansion:prepare": "node scripts/bg-art/prepare-expansion-v2.mjs",
    "expansion:check": "node scripts/bg-art/check-expansion-v2.mjs",
    "music:render": "node scripts/music/render-songs.mjs",
    "music:handovers": "node scripts/music/transition-check.mjs",
    "visual:shot": "node scripts/visual/shot.mjs",
    "visual:crop": "node scripts/visual/crop.mjs",
    "art:prepare": "node scripts/bg-art/prepare-local-art.mjs",
    "reward-art:prepare": "node scripts/bg-art/prepare-credit-puzzle.mjs",
    "pickups:prepare": "node scripts/bg-art/prepare-credit-puzzle.mjs credits",
    "puzzle:prepare": "node scripts/bg-art/prepare-credit-puzzle.mjs puzzle",
    "icons:prepare": "node scripts/bg-art/prepare-icons.mjs",
    "reward-art:check": "node scripts/bg-art/check-credit-puzzle-art.mjs",
    "predev": "pnpm art:prepare",
    "prebuild": "pnpm art:prepare",
    "duel-targets:prepare": "node scripts/bg-art/prepare-duel-targets.mjs",
    "combat-vfx-sequences:prepare": "node scripts/bg-art/prepare-duel-vfx-sequences.mjs",
    "chase:prepare": "node scripts/bg-art/prepare-ship-chase.mjs",
    "ship3d:prepare": "node scripts/bg-art/prepare-ship-3d.mjs",
    "music:catalog": "node scripts/music/build-world-music-catalog.mjs",
    "music:admin-preview": "tsx scripts/music/admin-world-music-preview.ts",
    "ships:admin-preview": "tsx scripts/admin/ship-registry-preview.ts",
    "equipment:admin-preview": "tsx scripts/admin/equipment-registry-preview.ts",
    "skills:admin-preview": "tsx scripts/admin/skill-registry-preview.ts",
    "enemies:admin-preview": "tsx scripts/admin/enemy-registry-preview.ts",
    "bosses:admin-preview": "tsx scripts/admin/boss-registry-preview.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "three": "0.170.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/three": "0.170.0",
    "@types/ws": "^8.18.2",
    "fake-indexeddb": "6.2.4",
    "sharp": "^0.34.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.21.0"
}
